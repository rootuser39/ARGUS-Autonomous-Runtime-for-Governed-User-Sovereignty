# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional model overrides. Token Factory model IDs are case-sensitive.
ARGUS_NEMOTRON_NANO_MODEL=nvidia/Nemotron-3_5-Lightning
ARGUS_NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
ARGUS_NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Runtime provider: stub | nebius
ARGUS_PROVIDER=stub

# Optional search integration
TAVILY_API_KEY=

# ARGUS runtime
ARGUS_MEMORY_PATH=.argus/memory.jsonl
